{
 "id": "HMAP8500_18",
 "kind": "table",
 "copies": [
  "0/07HMAP3/HMAP8500.PAC:18"
 ],
 "strings": [
  {
   "id": "HMAP8500_18:000",
   "jp": "「カード道場へ ようこそ！」{n}{n}{wait}",
   "en": "\"Welcome to the Card Dojo!\"{wait}"
  },
  {
   "id": "HMAP8500_18:001",
   "jp": "「道場の せつめいを{n} ききなさるか？」{n}",
   "en": "\"Would you like me to explain the dojo?\""
  },
  {
   "id": "HMAP8500_18:002",
   "jp": "「ここでは カードにまつわる{n} いろいろな 人と{n} 話すことが できる！」{wait}{n}「まず カードを{n} 交換してくれる人！」{n}{wait}",
   "en": "\"Here you can talk with all sorts of people who have to do with cards!\"{wait}\"First, the people who will trade cards with you!\"{wait}"
  },
  {
   "id": "HMAP8500_18:003",
   "jp": "「桃太郎さんの カードと{n} 別のカードを 交換しようと{n} いってくるから」{wait}{n}「交換したければ はい{n} したくなければ いいえを{n} えらぶことじゃ！」{wait}",
   "en": "\"They'll offer to trade one of your cards, Momotaro-san, for a different one.\"{wait}\"If you want to trade, choose Yes. If not, choose No!\"{wait}"
  },
  {
   "id": "HMAP8500_18:004",
   "jp": "「人は しょっちゅう{n} いれかわるから たまに{n} のぞきにくると いい！」{wait}{n}「次は 勝負を{n} いどんでくる人！」{n}{wait}",
   "en": "\"The people change all the time, so it's good to drop in now and then!\"{wait}\"Next, the people who'll challenge you to a match!\"{wait}"
  },
  {
   "id": "HMAP8500_18:005",
   "jp": "「じゃんけんで 勝つと{n} カードが もらえるぞ！」{n}{wait}{n}「負けても カードは{n} とられないから きらくに{n} ちょうせんしてくだされ！」{wait}",
   "en": "\"Win at rock-paper-scissors and you get a card!\"{wait}\"Even if you lose, they won't take your cards, so feel free to challenge them!\"{wait}"
  },
  {
   "id": "HMAP8500_18:006",
   "jp": "「ほかに カードを 売る人や{n} 話を するだけの人も{n} おりますぞ！」{wait}{n}「…といっても だいじな 話を{n} 知ってる人も いるから」{n}{wait}",
   "en": "\"There are also people who sell cards, and people who just chat!\"{wait}\"...That said, some of them know important things.\"{wait}"
  },
  {
   "id": "HMAP8500_18:007",
   "jp": "「全員と 話すのを{n} わすれないようにな！」{n}{wait}",
   "en": "\"So don't forget to talk to everyone!\"{wait}"
  },
  {
   "id": "HMAP8500_18:008",
   "jp": "「あとは そうじゃのう…」{n}{n}{wait}",
   "en": "\"And what else... let me see...\"{wait}"
  },
  {
   "id": "HMAP8500_18:009",
   "jp": "「おもての扉の 鍵を{n} 開けて おいたぞ！」{n}{wait}",
   "en": "\"I've unlocked the front door for you!\"{wait}"
  },
  {
   "id": "HMAP8500_18:010",
   "jp": "「これで 回り道を{n} せずに すむので{n} べんりだぞ！」{wait}",
   "en": "\"Now you won't have to go the long way around. Handy, eh!\"{wait}"
  },
  {
   "id": "HMAP8500_18:011",
   "jp": "「ゆっくりしていきなされ！」{n}{n}{wait}",
   "en": "\"Take your time!\"{wait}"
  },
  {
   "id": "HMAP8500_18:012",
   "jp": "「ずいぶん{n} ねっしんに 道場に{n} かよってくれますな！」{wait}",
   "en": "\"My, you've certainly been coming to the dojo eagerly!\"{wait}"
  },
  {
   "id": "HMAP8500_18:013",
   "jp": "「道場を いとなむ{n} わしとしては{n} うれしいかぎりです！」{wait}{n}「そこで お礼に{n} 桃太郎さんに これを{n} さしあげましょう！」{wait}",
   "en": "\"As the one who runs the dojo, nothing could make me happier!\"{wait}\"So, as thanks, let me give you this, Momotaro-san!\"{wait}"
  },
  {
   "id": "HMAP8500_18:014",
   "jp": "桃太郎は{n}{col10}桃太郎カード{col0}を{n}手に入れた！{c19}{wait}",
   "en": "Momotaro got the {col10}Momotaro Card{col0}!{c19}{wait}"
  },
  {
   "id": "HMAP8500_18:015",
   "jp": "「いつでも 道場に{n} 遊びに きてくだされ！」{n}{wait}",
   "en": "\"Come and play at the dojo anytime!\"{wait}"
  },
  {
   "id": "HMAP8500_18:016",
   "jp": "「今 いいところなんだから{n} じゃましないでください！」{n}{wait}",
   "en": "\"I'm at a good part right now, so don't bother me!\"{wait}"
  },
  {
   "id": "HMAP8500_18:017",
   "jp": "「この おじさん よわいから{n} 遊んでても つまんないや！」{n}{wait}",
   "en": "\"This old guy is so weak, playing with him is boring!\"{wait}"
  },
  {
   "id": "HMAP8500_18:018",
   "jp": "「くーっ！{n} もっと としよりを{n} いたわらんかい！」{wait}",
   "en": "\"Grr! Show some respect for your elders!\"{wait}"
  },
  {
   "id": "HMAP8500_18:019",
   "jp": "「勝負に なさけは{n} きんもつよ！」{n}{wait}",
   "en": "\"There's no room for mercy in a match!\"{wait}"
  },
  {
   "id": "HMAP8500_18:020",
   "jp": "「{str} をかけて{n} じゃんけん しませんか？」{n}",
   "en": "\"Want to play rock-paper-scissors for {str}?\""
  },
  {
   "id": "HMAP8500_18:021",
   "jp": "「じゃーんけーん…」{n}{n}",
   "en": "\"Rock... paper... scissors...\""
  },
  {
   "id": "HMAP8500_18:022",
   "jp": "「{str}！」{n}{n}{wait}",
   "en": "\"{str}!\"{wait}"
  },
  {
   "id": "HMAP8500_18:023",
   "jp": "「やられたか！{n} しょうがない 桃太郎さん！{n} これを どうぞ！」{wait}",
   "en": "\"You got me! Oh well, Momotaro-san! Here you go!\"{wait}"
  },
  {
   "id": "HMAP8500_18:024",
   "jp": "「勝った勝った！{n} 桃太郎さん まだまだ{n} 修行が たりないよ！」{wait}",
   "en": "\"I win, I win! Momotaro-san, you still need more training!\"{wait}"
  },
  {
   "id": "HMAP8500_18:025",
   "jp": "「あいこか！{n} よーし！{n} じゃーんけーん…」{wait}",
   "en": "\"A tie! All right! Rock... paper... scissors...\"{wait}"
  },
  {
   "id": "HMAP8500_18:026",
   "jp": "「じゃんけんしたくなったら{n} いつでも どうぞ！」{n}{wait}",
   "en": "\"Whenever you want to play rock-paper-scissors, come on by!\"{wait}"
  },
  {
   "id": "HMAP8500_18:027",
   "jp": "「そんなことじゃ{n} わたしの カードは{n} あげられないわね！」{wait}",
   "en": "\"With moves like that, I can't give you my card!\"{wait}"
  },
  {
   "id": "HMAP8500_18:028",
   "jp": "「村の中に 落ちている{n} カードも あるそうですよ！」{n}{wait}",
   "en": "\"They say there are cards lying around in the villages too!\"{wait}"
  },
  {
   "id": "HMAP8500_18:029",
   "jp": "「わーい！ わーい！{n} 桃太郎さんに{n} 勝っちゃったーっ！」{wait}",
   "en": "\"Yay! Yay! I beat Momotaro-san!\"{wait}"
  },
  {
   "id": "HMAP8500_18:030",
   "jp": "「金太郎さんや 浦島さんの{n} 村の人たち カードを{n} もってないのかな？」{wait}",
   "en": "\"Don't the people in Kintaro-san's and Urashima-san's villages have any cards?\"{wait}"
  },
  {
   "id": "HMAP8500_18:031",
   "jp": "「おやまあ！{n} 勝ってしまいましたわい！」{n}{wait}",
   "en": "\"Oh my! I seem to have won!\"{wait}"
  },
  {
   "id": "HMAP8500_18:032",
   "jp": "「思いもよらぬ人が{n} カードを くれることも{n} ありますぞ！」{wait}",
   "en": "\"Sometimes people you'd never expect will give you cards!\"{wait}"
  },
  {
   "id": "HMAP8500_18:033",
   "jp": "「へっへっへ！{n} ざんねんだったね！{n} 桃太郎さん！」{wait}",
   "en": "\"Heh heh heh! Too bad, Momotaro-san!\"{wait}"
  },
  {
   "id": "HMAP8500_18:034",
   "jp": "「桃太郎さんの おじいさんや{n} おばあさんの カードは{n} もう もってますか？」{wait}",
   "en": "\"Do you have the cards of Momotaro-san's Grandpa and Grandma yet?\"{wait}"
  },
  {
   "id": "HMAP8500_18:035",
   "jp": "「あれー？{n} 桃太郎さんが 負けるなんて{n} かっちょわりーっ！」{wait}",
   "en": "\"Huh? Momotaro-san lost? How uncool!\"{wait}"
  },
  {
   "id": "HMAP8500_18:036",
   "jp": "「寝太郎さんの カードが{n} あるんだって！」{wait}{n}「寝太郎さんが{n} 目を さましたら なにか{n} しってるかもね！」{wait}",
   "en": "\"They say there's a Netaro Card!\"{wait}\"If Netaro-san wakes up, maybe he'll know something!\"{wait}"
  },
  {
   "id": "HMAP8500_18:037",
   "jp": "「あらあら！{n} 桃太郎さん ごめんなさいね！」{n}{wait}",
   "en": "\"Oh dear! I'm sorry, Momotaro-san!\"{wait}"
  },
  {
   "id": "HMAP8500_18:038",
   "jp": "「一度しか 話してない人が{n} いたら もう一度 話して{n} みては どうでしょう？」{wait}",
   "en": "\"If there's anyone you've only talked to once, why not try talking to them again?\"{wait}"
  },
  {
   "id": "HMAP8500_18:039",
   "jp": "「すみませんのう！{n} まさか 勝ってしまうとは！」{n}{wait}",
   "en": "\"I'm so sorry! I never thought I'd win!\"{wait}"
  },
  {
   "id": "HMAP8500_18:040",
   "jp": "「だじゃれ大会の 会場では{n} たくさん カードが{n} もらえるそうですよ！」{wait}",
   "en": "\"They say you can get lots of cards at the Pun Contest venue!\"{wait}"
  },
  {
   "id": "HMAP8500_18:041",
   "jp": "「桃太郎さんの{n} {str} を」{n}{wait}",
   "en": "\"Momotaro-san, your {str}...\"{wait}"
  },
  {
   "id": "HMAP8500_18:042",
   "jp": "「桃太郎さんの{n} {str} と{n} {str} を」{wait}",
   "en": "\"Momotaro-san, your {str} and {str}...\"{wait}"
  },
  {
   "id": "HMAP8500_18:043",
   "jp": "「ああ！{n} あしながオニさんカードは{n} どこに あるんだ…」{wait}",
   "en": "\"Ahh! Where could the Daddy Long-Oni Card be...\"{wait}"
  },
  {
   "id": "HMAP8500_18:044",
   "jp": "「村に 入ったら イヌに{n} 地面を さがさせると{n} いいですよ！」{wait}",
   "en": "\"Once you're in a village, it's a good idea to have Dog search the ground!\"{wait}"
  },
  {
   "id": "HMAP8500_18:045",
   "jp": "「あーん！ カッコイイ{n} ビジュアル系の鬼カードが{n} ほしいわ！」{wait}",
   "en": "\"Ohh! I want a cool Visual Kei Oni Card!\"{wait}"
  },
  {
   "id": "HMAP8500_18:046",
   "jp": "「ある人に おくりものを すると{n} カードを もらえる ときが{n} あるのよ！」{wait}{n}「おくりものと いったら{n} やっぱり 花なんか{n} すてきよねえ！」{wait}",
   "en": "\"Sometimes when you give someone a present, they'll give you a card!\"{wait}\"And when it comes to presents, flowers are just lovely, aren't they!\"{wait}"
  },
  {
   "id": "HMAP8500_18:047",
   "jp": "「赤鬼と 青鬼は{n} コレクションの{n} きほんだよね」{wait}",
   "en": "\"Red Oni and Blue Oni are the basics of any collection, right?\"{wait}"
  },
  {
   "id": "HMAP8500_18:048",
   "jp": "「魚で カードが{n} もらえるって ほんとかな？」{n}{wait}",
   "en": "\"Can you really get a card for fish, I wonder?\"{wait}"
  },
  {
   "id": "HMAP8500_18:049",
   "jp": "「わしは めずらしい場所に{n} すむ 鬼の カードを{n} あつめております！」{wait}",
   "en": "\"I collect cards of oni who live in unusual places!\"{wait}"
  },
  {
   "id": "HMAP8500_18:050",
   "jp": "「わしらには 鬼のカードは{n} 集められんからのお！」{n}{wait}{n}「桃太郎さんに{n} 交換してもらうしか{n} ないんじゃよ！」{wait}",
   "en": "\"Folks like us can't collect oni cards, you see!\"{wait}\"Our only hope is for you to trade with us, Momotaro-san!\"{wait}"
  },
  {
   "id": "HMAP8500_18:051",
   "jp": "「お金を 盗むという カッパの{n} カードを 商売の おまもりに{n} しようと 思いましてな！」{wait}",
   "en": "\"They say Kappa steal money, so I thought I'd keep a Kappa card as a charm for my business!\"{wait}"
  },
  {
   "id": "HMAP8500_18:052",
   "jp": "「10匹 こらしめて 手に入る{n} カードは なくなっても また{n} 手に入れることが できますよ！」{wait}",
   "en": "\"Cards you earn by teaching 10 oni of one kind a lesson can be earned again, even if you lose them!\"{wait}"
  },
  {
   "id": "HMAP8500_18:053",
   "jp": "「ピンク鬼カードは とても{n} めずらしい カードです！」{n}{wait}{n}「がんばって{n} さがしてみて ください！」{n}{wait}",
   "en": "\"The Pink Oni Card is a very rare card!\"{wait}\"Do your best to find it!\"{wait}"
  },
  {
   "id": "HMAP8500_18:054",
   "jp": "「都の 料亭の わかだんなの{n} カードも あるそうですよ！」{n}{wait}{n}「料亭の おとくいさんに{n} なってみては どうです？」{n}{wait}",
   "en": "\"They say there's a card of the young master of the Capital's restaurant, too!\"{wait}\"Why not become one of the restaurant's regulars?\"{wait}"
  },
  {
   "id": "HMAP8500_18:055",
   "jp": "「こちらでは きちょうなカードを{n} とっても おとくな ねだんで{n} ていきょうしています！」{wait}",
   "en": "\"Here we offer precious cards at real bargain prices!\"{wait}"
  },
  {
   "id": "HMAP8500_18:056",
   "jp": "「よにも めずらしい{n} {str} を{n} たったの{num}両で！」{wait}",
   "en": "\"The rarest of the rare, {str}, for only {num} ryo!\"{wait}"
  },
  {
   "id": "HMAP8500_18:057",
   "jp": "「お買い上げになりますか？」{n}{n}",
   "en": "\"Will you buy it?\""
  },
  {
   "id": "HMAP8500_18:058",
   "jp": "「桃太郎さん！{n} いい 買い物ですよ！{n} まいどあり！」{wait}",
   "en": "\"Momotaro-san! That's a good buy! Thanks a bunch!\"{wait}"
  },
  {
   "id": "HMAP8500_18:059",
   "jp": "「桃太郎さん！{n} こちとらも しょうばいだ！{n} このねだんは まけられねえ！」{wait}",
   "en": "\"Momotaro-san! I gotta make a living too! I can't knock a thing off this price!\"{wait}"
  },
  {
   "id": "HMAP8500_18:060",
   "jp": "「お金を ためて また{n} 出直してきてくださいよ！」{n}{wait}",
   "en": "\"Save up your money and come back again!\"{wait}"
  },
  {
   "id": "HMAP8500_18:061",
   "jp": "「もったいない！{n} こんな ほりだしもの{n} 二度と 手に入らないよ！」{wait}",
   "en": "\"What a waste! You'll never get your hands on a find like this again!\"{wait}"
  },
  {
   "id": "HMAP8500_18:062",
   "jp": "「気が かわったら{n} また どうぞ！」{n}{wait}",
   "en": "\"If you change your mind, come again!\"{wait}"
  },
  {
   "id": "HMAP8500_18:063",
   "jp": "「こちらは みせじまいと{n} させて いただきます！」{n}{wait}",
   "en": "\"We'll be closing up shop now!\"{wait}"
  },
  {
   "id": "HMAP8500_18:064",
   "jp": "「桃太郎さん！{n} いい あきないを{n} させてもらいました！」{wait}",
   "en": "\"Momotaro-san! It's been a pleasure doing business!\"{wait}"
  },
  {
   "id": "HMAP8500_18:065",
   "jp": "「わしは カードの{n} 生きじびきと{n} よばれておる！」{wait}",
   "en": "\"I am known as the walking card encyclopedia!\"{wait}"
  },
  {
   "id": "HMAP8500_18:066",
   "jp": "「カードの ばんごうを いえば{n} それが なんの カードか{n} おしえて しんぜよう！」{wait}",
   "en": "\"Tell me a card's number, and I shall tell you what card it is!\"{wait}"
  },
  {
   "id": "HMAP8500_18:067",
   "jp": "「おぬしの しりたい カードの{n} ばんごうは なんばんかな？」{n}{wait}",
   "en": "\"What is the number of the card you wish to know about?\"{wait}"
  },
  {
   "id": "HMAP8500_18:068",
   "jp": "「1から297までの 中から{n} ばんごうを えらぶのじゃ！」{n}{wait}",
   "en": "\"Choose a number from 1 to 297!\"{wait}"
  },
  {
   "id": "HMAP8500_18:069",
   "jp": "「ひやかしなら よそへ{n} いって やれ！」{n}{wait}",
   "en": "\"If you're only browsing, go browse somewhere else!\"{wait}"
  },
  {
   "id": "HMAP8500_18:070",
   "jp": "「うむ！ それは…」{n}{n}{wait}",
   "en": "\"Hmm! That one is...\"{wait}"
  },
  {
   "id": "HMAP8500_18:071",
   "jp": "「{str}{n} じゃ！」{n}{wait}",
   "en": "\"{str}!\"{wait}"
  },
  {
   "id": "HMAP8500_18:072",
   "jp": "「しりたい カードが{n} あれば いつでも{n} くるがええ！」{wait}",
   "en": "\"If there's a card you wish to know about, come anytime!\"{wait}"
  },
  {
   "id": "HMAP8500_18:073",
   "jp": "「わーい！{n} ボク もう 5枚も{n} カードが たまったよ！」{wait}",
   "en": "\"Yay! I've already collected 5 cards!\"{wait}"
  },
  {
   "id": "HMAP8500_18:074",
   "jp": "「カード道場の うわさは{n} きいていましたが{n} すごい ねっきですね！」{wait}",
   "en": "\"I'd heard rumors about the Card Dojo, but what enthusiasm!\"{wait}"
  },
  {
   "id": "HMAP8500_18:075",
   "jp": "「ここの 道場主さんは{n} すごい カードを{n} もってるそうですよ！」{wait}",
   "en": "\"They say the master of this dojo has an amazing card!\"{wait}"
  },
  {
   "id": "HMAP8500_18:076",
   "jp": "「桃太郎さん！」{n}{n}{wait}",
   "en": "\"Momotaro-san!\"{wait}"
  },
  {
   "id": "HMAP8500_18:077",
   "jp": "桃太郎は{n}{col10}{str}{col0} を{n}手に入れた！{c19}{wait}",
   "en": "Momotaro got the {col10}{str}{col0}!{c19}{wait}"
  },
  {
   "id": "HMAP8500_18:078",
   "jp": "「桃太郎さん！ひどいや！{n} カードを もってないじゃ{n} ないですか！」{wait}",
   "en": "\"Momotaro-san! That's mean! You don't even have the card!\"{wait}"
  },
  {
   "id": "HMAP8500_18:079",
   "jp": "「そうですか！{n} 交換する気になったら{n} いつでも どうぞ！」{wait}",
   "en": "\"I see! Whenever you feel like trading, just come by!\"{wait}"
  },
  {
   "id": "HMAP8500_18:080",
   "jp": "「どうも ありがとう！」{n}{n}{wait}",
   "en": "\"Thanks a lot!\"{wait}"
  },
  {
   "id": "HMAP8500_18:081",
   "jp": "「{str} と{n} 交換しませんか？」{n}{wait}",
   "en": "\"...would you trade for {str}?\"{wait}"
  },
  {
   "id": "HMAP8500_18:082",
   "jp": "グー",
   "en": "Rock"
  },
  {
   "id": "HMAP8500_18:083",
   "jp": "チョキ",
   "en": "Scissors"
  },
  {
   "id": "HMAP8500_18:084",
   "jp": "パー",
   "en": "Paper"
  },
  {
   "id": "HMAP8500_18:085",
   "jp": "桃太郎カード",
   "en": "Momotaro Card"
